OPENAI_API_KEY=
NOTION_TOKEN=
NOTION_PARENT_PAGE_ID=
RESEARCHER_PROVIDER=openai
PLANNER_PROVIDER=openai
IMPLEMENTER_PROVIDER=openai
TESTER_PROVIDER=openai
VERIFIER_PROVIDER=openai
# Provider options: openai, codex-cli, mock
RESEARCHER_MODEL=gpt-5.5
PLANNER_MODEL=gpt-5.5
IMPLEMENTER_MODEL=gpt-5.5
TESTER_MODEL=gpt-5.5
VERIFIER_MODEL=gpt-5.5
# Reasoning options: default, none, minimal, low, medium, high, xhigh
AGENT_REASONING_EFFORT=default
IMPLEMENTER_REASONING_EFFORT=high
# Speed options: default, auto, fast
AGENT_SERVICE_TIER=default
# Optional: set when codex.exe is not on PATH.
CODEX_CLI_PATH=
# Codex CLI sandbox options: read-only, workspace-write, danger-full-access.
# Windows shell execution may require danger-full-access.
CODEX_CLI_SANDBOX=danger-full-access
MOCK_AGENTS=1
HARNESS_DB_PATH=.data/harness.sqlite
# Optional absolute path for image attachments. Leave empty to use .data/attachments.
HARNESS_ATTACHMENT_DIR=
HARNESS_INTEGRATION_BRANCH=imjae
MAX_AGENT_ROUNDS=3
AGENT_CONTEXT_BUDGET_CHARS=30000
AGENT_OUTPUT_BUDGET_CHARS=8000
AGENT_TIME_BUDGET_MS=300000
IMPLEMENTER_TIME_BUDGET_MS=900000
